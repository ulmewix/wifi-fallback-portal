# Example configuration for rpi-wifi-fallback-portal
# Copy to /etc/wifi-fallback-portal/portal.env (chmod 600) and edit.

HOME_SSID="your_wifi_name" # Home_SSID (your main home WiFi SSID)
HOME_PASSWORD="your_wifi_password" # Home_PASSWORD (password for your home WiFi)
AP_SSID="your_portal_ap_name" # AP_SSID (SSID for the fallback hotspot)
AP_PASSWORD="your_portal_ap_password" # AP_PASSWORD (password for the fallback hotspot; min 8 chars)
WEB_PORT="4999" # WEB_PORT (port used by the web portal)
WEB_API_KEY="change_me_api_key" # WEB_API_KEY (required for poweroff API; blank to disable)
WIFI_IFACE="wlan0" # WIFI_IFACE (wireless interface used by NetworkManager)

