[Unit]
Description=Wi-Fi Fallback Portal (Flask/Gunicorn)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory=/opt/wifi-fallback-portal/web
EnvironmentFile=/etc/wifi-fallback-portal/portal.env
ExecStart=/opt/wifi-fallback-portal/venv/bin/gunicorn -b 0.0.0.0:${WEB_PORT} app:app
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

